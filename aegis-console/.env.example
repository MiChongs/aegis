# ── 服务端专用：Next.js 反向代理目标（浏览器看不到） ──
# 浏览器请求 /api/* 会被 Next.js 转发到该后端 + 保持 Cookie / WebSocket
AEGIS_API_BACKEND=http://127.0.0.1:8088

# ── 品牌信息（可选） ──
NEXT_PUBLIC_AEGIS_CONSOLE_NAME=Aegis Console
NEXT_PUBLIC_AEGIS_PLATFORM_NAME=Aegis
NEXT_PUBLIC_AEGIS_ENVIRONMENT=Development

# ── 直连模式（仅在确需绕过 Next.js 代理时启用） ──
# 设置后浏览器会直接请求该地址，需自行处理 CORS / 混合内容
# NEXT_PUBLIC_AEGIS_API_BASE_URL=https://api.example.com
# NEXT_PUBLIC_AEGIS_WS_URL=wss://api.example.com/api/ws
