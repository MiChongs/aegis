APP_NAME=aegis
APP_ENV=development
HTTP_PORT=8088

# 开发者门户地址（aegis-console 的 /developers）。
# 后端的 /docs 与 /docs/tags/:slug 只做 302 跳转，文档本体由门户承载。
# 同源部署保持默认相对路径；前后端分域时填绝对地址，例如 https://console.example.com/developers
DOCS_PORTAL_URL=/developers
# 管理控制台对外地址。统一通知出口用它拼「查看工单」等深链。
# 留空时通知里只带相对路径，飞书卡片/邮件里点不开，因此分域部署务必填绝对地址。
# 例如 https://console.example.com
CONSOLE_BASE_URL=
# 本服务自身的对外地址。凭证邮件里的下载链接这类**必须绝对**的地址由它拼出 ——
# 邮件客户端里没有「当前站点」，相对路径点不开。
# 留空时凭证邮件退化为只带 PDF 附件；若邮件通道又不支持附件（Zeabur），寄送会直接报错。
# 例如 https://api.example.com
API_BASE_URL=
# 仅填写实际反向代理 CIDR，留空表示不信任任何转发头。
# Cloudflare Tunnel 本机 sidecar 常用 127.0.0.1/32；请按实际拓扑配置。
TRUSTED_PROXIES=

# ── 启动横幅 ────────────────────────────────────────────────────────
# 进程启动时打印的艺术字 + 运行时明细表（构建 / 进程 / 主机 / 数据面 / 安全 /
# 能力 / 入口）。只在启动时打印一次，不参与任何业务逻辑。
BANNER_ENABLED=true
# auto | full | compact | minimal | off
#   auto    交互式终端给全量彩色，重定向到文件/日志时给全量纯文本（推荐）
#   full    始终打完整表格      compact 只打艺术字与摘要行
#   minimal 只打摘要行（日志采集侧用）  off 完全不打
BANNER_STYLE=auto
# FIGlet 字体名，内嵌 148 种（slant / standard / big / block / small / doom …）
BANNER_FONT=slant
# auto | always | never；auto 之外还会遵循 NO_COLOR / FORCE_COLOR / TERM 的标准判定
BANNER_COLOR=auto
# 强制列宽；0 = 自动探测终端宽度，探测不到用 100
BANNER_WIDTH=0
# 是否采集宿主机 CPU / 内存 / 磁盘。采集要问 WMI（Windows）或挂载点（Linux），
# 极少数环境下会慢，可以单独关掉而保留其余分区。
BANNER_SHOW_HOST=true
# 是否显示「路由」分区（按顶层命名空间计数 + 鉴权说明）。
# 完整清单不进横幅——近千条路由那是滚屏而不是横幅，用 `go run ./cmd/server routes` 看。
BANNER_SHOW_ROUTES=true

# 跨域默认关闭；前后端分离部署时只填写明确的控制台来源。
CORS_ENABLED=true
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
ADMIN_API_TOKEN=change-admin-token
ADMIN_BOOTSTRAP_ACCOUNT=superadmin
ADMIN_BOOTSTRAP_PASSWORD=AegisAdmin@2026!
ADMIN_BOOTSTRAP_DISPLAY_NAME=Super Administrator
ADMIN_BOOTSTRAP_EMAIL=admin@aegis.local
APP_DEFAULT_IANA_TIMEZONE=Asia/Shanghai
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
SHUTDOWN_TIMEOUT=10s

JWT_SECRET=change-me
JWT_ISSUER=aegis
JWT_TTL=720h
JWT_REFRESH_TTL=168h
# 生产环境必须使用独立且长期稳定的随机密钥；轮换它前需先轮换/迁移所有加密凭据。
# 加密范围包括：OAuth client_secret、通知渠道密钥、Zeabur Email 的 API Key 与 Webhook 密钥。
SECURITY_MASTER_KEY=change-me-to-an-independent-32-byte-or-longer-secret

# ── 法律文本 ──
# 用户协议与隐私政策里「联系我们」一节公示的地址。
# 服务端内置了简体中文与英文两份完整条款，管理员可在控制台
# 「内容中心 · 法律文本」里改写或新增语言；未自定义的语言对外发内置版本。
#
# **留空时服务端不生造一个地址**，而是原样印出「本部署尚未配置联系邮箱」——
# 假邮箱写在隐私政策里比明说没配更有害，用户会照着它发信然后石沉大海。
LEGAL_CONTACT_EMAIL=

# ── Passkey / WebAuthn ──
# RP ID 决定 Passkey 绑在哪个域名上。浏览器只接受「等于当前页面域名，或它的可注册后缀」，
# 不满足时 navigator.credentials.create() 直接抛
#   The relying party ID is not a registrable domain suffix of, nor equal to the current domain.
#
# **留空即跟随每次访问的域名**（推荐）：同一套服务同时被 localhost、127.0.0.1
# 和正式域名访问时，只有留空才三边都能用。
# 只有想让凭据跨子域通用时才填父域，例如填 example.com 后
# console.example.com 与 admin.example.com 共享同一批 Passkey。
# 改动此项会让已绑定的 Passkey 全部失效（RP ID 是凭据作用域的一部分）。
SECURITY_PASSKEY_RP_ID=
# 允许发起 Passkey 的完整来源，逗号分隔。这是唯一的安全边界，必须逐条列全 ——
# scheme、host、端口任一不同即为不同来源（http://localhost:3000 不覆盖 http://127.0.0.1:3000）。
# 留空时使用内置开发缺省：http://localhost:3000,http://127.0.0.1:3000
SECURITY_PASSKEY_RP_ORIGINS=
# 弹窗上显示给用户的名称，留空取 APP_NAME
SECURITY_PASSKEY_RP_DISPLAY_NAME=
# preferred(默认) / required / discouraged
SECURITY_PASSKEY_USER_VERIFICATION=preferred

POSTGRES_DSN=postgres://aegis:aegis@postgres:5432/aegis?sslmode=disable
POSTGRES_SESSION_TIMEZONE=Asia/Shanghai
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=30m
# ── 连接生命周期 ──
# 生命期抖动：让同批连接错峰到期，避免整池同时重连
POSTGRES_MAX_CONN_LIFETIME_JITTER=5m
# 空闲多久回收（缩回 MIN_CONNS）
POSTGRES_MAX_CONN_IDLE_TIME=5m
# 池自检周期：回收超龄/空闲连接并补足 MIN_CONNS
POSTGRES_HEALTH_CHECK_PERIOD=1m
POSTGRES_CONNECT_TIMEOUT=10s
POSTGRES_APPLICATION_NAME=aegis
# ── 会话级强制超时（随连接下发，对该连接上所有语句生效；0 = 不限制）──
# 单条语句最长执行时间：防止一条慢 SQL 长期占住连接
POSTGRES_STATEMENT_TIMEOUT=30s
# 事务开着不干活多久由服务端结束会话：事务泄漏的兜底闸
POSTGRES_IDLE_IN_TX_TIMEOUT=60s
# 等锁最长时间
POSTGRES_LOCK_TIMEOUT=10s

# ── 数据库可观测性与泄漏治理 ──
DB_MONITOR_ENABLED=true
DB_MONITOR_INTERVAL=15s
DB_HISTORY_RETAIN=1h
DB_SLOW_QUERY_THRESHOLD=200ms
DB_VERY_SLOW_QUERY_THRESHOLD=2s
DB_SLOW_QUERY_SAMPLES=50
DB_LEAK_DETECTION=true
DB_LEAK_WINDOW=20
# 连接被借出超过该时长即判定为疑似泄漏（正常请求是毫秒级）
DB_CONN_HOLD_THRESHOLD=30s
# 获取连接时抓调用栈：唯一能把连接泄漏定位到代码行的手段
DB_TRACK_ACQUIRE_STACK=true
DB_IDLE_IN_TX_THRESHOLD=60s
DB_LONG_QUERY_THRESHOLD=30s
# 自动终止超时的 idle in transaction 会话（会杀掉外部客户端的会话，默认关闭）
DB_AUTO_TERMINATE_IDLE_IN_TX=false
DB_AUTO_TERMINATE_THRESHOLD=5m
DB_WARMUP_ON_START=true
DB_DRAIN_TIMEOUT=15s

LEGACY_MYSQL_DSN=root:password@tcp(127.0.0.1:3306)/usersystem?charset=utf8mb4&parseTime=true&loc=Local
LEGACY_MYSQL_BATCH_SIZE=500
LEGACY_MYSQL_CONCURRENCY=8

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=aegis

# ── 支付凭证（收据 / 账单 / 退款凭证）──
# 导出文件的落盘位置与有效期
PAYMENT_RECEIPT_ROOT_DIR=data/payment-bills
PAYMENT_RECEIPT_TTL=30m
PAYMENT_RECEIPT_CLEANUP_INTERVAL=5m

# 默认语言。凭证可能寄往任何地方，英文是最不会读不懂的兜底；
# 且英文只用内嵌字体，任何环境下都出得来。
# 可选：en / zh-Hans / zh-Hant / ja / ko / de / es / fr / pt-BR / ru
PAYMENT_RECEIPT_DEFAULT_LOCALE=en

# 中日韩字体。**只有中文 / 日文 / 韩文凭证需要它**：拉丁字形内嵌在二进制里，
# 不配置也能出英文、德文、法文、俄文等凭证。
#
# 必须是 TrueType 轮廓的 .ttf 或 .ttc；**.otf 不支持**（CFF 轮廓，PDF 引擎嵌不了）。
# 留空时按「PAYMENT_RECEIPT_FONT_DIRS → assets/fonts → data/fonts → 系统字体目录」查找，
# 找不到则中文凭证自动降级为英文并在日志里告警。
# Docker 镜像已预装 font-noto-cjk，容器部署通常不需要配。
PAYMENT_RECEIPT_FONT_PATH=
PAYMENT_RECEIPT_FONT_BOLD_PATH=
PAYMENT_RECEIPT_FONT_DIRS=
# 容器里字体是显式装进来的，可关掉系统字体目录扫描省一轮遍历
PAYMENT_RECEIPT_DISABLE_SYSTEM_FONTS=false

# 凭证邮件：链接有效期明显长于导出 TTL —— 邮件可能几天后才被打开，
# 一条半小时就失效的链接等于没发。
PAYMENT_RECEIPT_EMAIL_LINK_TTL=168h
# 同一收件地址每天最多收到几封凭证邮件（用户自助补发的防滥用上限）
PAYMENT_RECEIPT_EMAIL_PER_DAY=10

ADMIN_USER_SEARCH_ROOT_DIR=data/search
ADMIN_USER_SEARCH_BATCH_SIZE=2000
ADMIN_USER_SEARCH_MAX_PINYIN_PATHS=16
ADMIN_USER_SEARCH_WARMUP_ENABLED=true
ADMIN_USER_SEARCH_WARMUP_CONCURRENCY=2

ACCOUNT_BAN_CLEANUP_ENABLED=true
ACCOUNT_BAN_CLEANUP_SPEC=@every 1m
ACCOUNT_BAN_CLEANUP_BATCH_SIZE=200

RISK_IP_REPUTATION_PROVIDER=none
RISK_IP_REPUTATION_CACHE_TTL=6h
RISK_IP_REPUTATION_TIMEOUT=1500ms
RISK_IP_REPUTATION_ALLOW_STALE=true
RISK_IPQUALITYSCORE_API_KEY=
RISK_IPQUALITYSCORE_BASE_URL=https://www.ipqualityscore.com/api/json/ip
RISK_IPQUALITYSCORE_STRICTNESS=1
RISK_IPQUALITYSCORE_FAST=true
RISK_IPQUALITYSCORE_MOBILE=false
RISK_IPQUALITYSCORE_LIGHTER_PENALTIES=false
RISK_RATE_LIMIT_ENABLED=false
RISK_RATE_LIMIT_IP_PER_MINUTE=120
RISK_RATE_LIMIT_ACCOUNT_PER_MINUTE=30
RISK_RATE_LIMIT_DEVICE_PER_MINUTE=60
RISK_RATE_LIMIT_ACCOUNT_DEVICE_PER_MINUTE=20

# 登录地理风控（Worker 近线判定：不可能旅行 / 新国家 / 远离常驻地）
# 依赖 PostGIS（见 deploy/docker/postgres/Dockerfile 与 migrations/postgres/000054）
GEORISK_ENABLED=true
GEORISK_MAX_SPEED_KMH=900
GEORISK_MIN_TRAVEL_KM=100
GEORISK_NEW_COUNTRY_MIN_LOGINS=3
GEORISK_PROFILE_CACHE_TTL=72h
GEORISK_RETENTION_MONTHS=6
GEORISK_ROLLUP_INTERVAL=10m
GEORISK_PROFILE_RECOMPUTE_DAYS=90

NATS_URL=nats://nats:4222
NATS_STREAM_NAME=AEGIS_EVENTS

TEMPORAL_HOST_PORT=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=aegis-workflow
TEMPORAL_WORKFLOW_EXECUTION_TIMEOUT=720h
TEMPORAL_WORKFLOW_RUN_TIMEOUT=24h
TEMPORAL_WORKFLOW_TASK_TIMEOUT=30s
TEMPORAL_ACTIVITY_TIMEOUT=30s

# Temporal Web UI（docker-compose temporal-ui 服务使用）
TEMPORAL_UI_PORT=8233
TEMPORAL_UI_BACKEND_ADDRESS=temporal:7233
TEMPORAL_UI_CORS_ORIGINS=http://localhost:3000,http://localhost:8088
TEMPORAL_UI_PUBLIC_PATH=
# OIDC 认证（启用后需填写 Provider 信息；如使用 Casdoor，PROVIDER_URL 指向 /.well-known/openid-configuration 的 issuer）
TEMPORAL_AUTH_ENABLED=false
TEMPORAL_AUTH_PROVIDER_URL=
TEMPORAL_AUTH_CLIENT_ID=
TEMPORAL_AUTH_CLIENT_SECRET=
TEMPORAL_AUTH_CALLBACK_URL=http://localhost:8233/auth/sso/callback
TEMPORAL_AUTH_SCOPES=openid,profile,email
# 生产环境请置为 false（需 HTTPS）
TEMPORAL_CSRF_COOKIE_INSECURE=true
# Web UI 默认语言（zh / en / ja 等）
TEMPORAL_UI_DEFAULT_LANGUAGE=zh

# NATS Web UI（nats-nui/nui）
NATS_UI_PORT=31311

AUTO_SIGN_ENABLED=true
AUTO_SIGN_TIMEZONE=Asia/Shanghai
AUTO_SIGN_TICK_INTERVAL=1m
AUTO_SIGN_REBUILD_INTERVAL=15m
AUTO_SIGN_BATCH_SIZE=200
AUTO_SIGN_CONCURRENCY=8
AUTO_SIGN_RETRY_DELAY=5m

# ── 第三方登录（OAuth2）平台级兜底配置 ──
# 推荐做法：在管理后台「应用 → 第三方登录」按应用配置渠道（密钥加密存储、支持自定义
# 渠道与字段映射、可单独控制登录/注册/绑定）。
# 下面这些 OAUTH_* 仅作为**未做应用级配置时的全局兜底**保留：某个应用一旦在后台建了
# 同名渠道，即以应用级配置为准（包括在后台把它停用）。
OAUTH_QQ_CLIENT_ID=
OAUTH_QQ_CLIENT_SECRET=
OAUTH_QQ_REDIRECT_URL=http://localhost:8088/api/auth/oauth2/callback?provider=qq
OAUTH_WECHAT_CLIENT_ID=
OAUTH_WECHAT_CLIENT_SECRET=
OAUTH_WECHAT_REDIRECT_URL=http://localhost:8088/api/auth/oauth2/callback?provider=wechat
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URL=http://localhost:8088/api/auth/oauth2/callback?provider=github
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=http://localhost:8088/api/auth/oauth2/callback?provider=google
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_REDIRECT_URL=http://localhost:8088/api/auth/oauth2/callback?provider=microsoft
OAUTH_WEIBO_CLIENT_ID=
OAUTH_WEIBO_CLIENT_SECRET=
OAUTH_WEIBO_REDIRECT_URL=http://localhost:8088/api/auth/oauth2/callback?provider=weibo



# ═══════════════════════════════════════════════════════════════════
# OpenTelemetry 分布式追踪（TraceID 全局启用）
# ═══════════════════════════════════════════════════════════════════
# 行为说明：
#   ·TRACING_ENABLED=true 是默认值；即使 EXPORTER=none，TraceID 仍会生成，
#     并注入 X-Trace-ID 响应头 + response.Envelope.traceId 字段。
#   ·所有 Aegis 项目变量优先级高于 OTEL_* 标准变量；后者仅作为回退。
#
# ─── 基础开关 ───────────────────────────────────────────────────────
TRACING_ENABLED=true

# Exporter 类型：otlp-http | otlp-grpc | stdout | none
#   留空时若配置了 TRACING_ENDPOINT 则自动推断：
#     http://* / https://*  → otlp-http
#     其他                 → otlp-grpc
TRACING_EXPORTER=

# OTLP Collector 端点。留空 = 不导出（仍生成 TraceID）。
#   otlp-http  示例: http://localhost:4318   (4318 是 OTLP/HTTP 默认端口)
#   otlp-grpc  示例: localhost:4317          (4317 是 OTLP/gRPC 默认端口)
TRACING_ENDPOINT=

# 是否跳过 TLS 校验。默认 true；当 endpoint 以 https:// 开头时默认 false。
TRACING_INSECURE=true

# 附加请求头（常用于 SaaS 后端鉴权 token），格式: "key1=value1,key2=value2"
TRACING_HEADERS=

# ─── 采样策略 ───────────────────────────────────────────────────────
# 可选值：
#   always_on                ：全量采样（默认）
#   always_off               ：完全关闭采样
#   traceid_ratio            ：按 TRACING_SAMPLE_RATIO 概率采样
#   parentbased_always_on    ：继承上游决策；无父 span 时全采
#   parentbased_ratio        ：继承上游决策；无父 span 时按 ratio 采
TRACING_SAMPLER=always_on
TRACING_SAMPLE_RATIO=1.0

# ─── Resource 元数据（留空 = 使用 APP_NAME / APP_ENV）───────────────
TRACING_SERVICE_NAME=
TRACING_SERVICE_VERSION=
TRACING_ENVIRONMENT=

# ─── 批量导出参数 ───────────────────────────────────────────────────
TRACING_BATCH_TIMEOUT=5s
TRACING_EXPORT_TIMEOUT=10s

# ═══════════════════════════════════════════════════════════════════
# 场景示例（按需取消注释一段，并注释掉上面的默认值）
# ═══════════════════════════════════════════════════════════════════
#
# ┌──────────────────────────────────────────────┐
# │ 示例 A：本地开发（不外发，仅生成 TraceID）    │
# │ 默认配置即可；无需改动                        │
# └──────────────────────────────────────────────┘
#
# ┌──────────────────────────────────────────────┐
# │ 示例 B：调试 —— span 打印到 stdout            │
# └──────────────────────────────────────────────┘
# TRACING_EXPORTER=stdout
#
# ┌──────────────────────────────────────────────┐
# │ 示例 C：本地 Jaeger / OTel Collector (gRPC)  │
# │ docker run -p 4317:4317 jaegertracing/...    │
# └──────────────────────────────────────────────┘
# TRACING_EXPORTER=otlp-grpc
# TRACING_ENDPOINT=localhost:4317
# TRACING_INSECURE=true
#
# ┌──────────────────────────────────────────────┐
# │ 示例 D：本地 Tempo / Collector (HTTP)         │
# └──────────────────────────────────────────────┘
# TRACING_EXPORTER=otlp-http
# TRACING_ENDPOINT=http://localhost:4318
# TRACING_INSECURE=true
#
# ┌──────────────────────────────────────────────┐
# │ 示例 E：Grafana Cloud (Tempo SaaS, HTTP)      │
# │ Basic Auth = base64("<stack-id>:<api-key>")   │
# └──────────────────────────────────────────────┘
# TRACING_EXPORTER=otlp-http
# TRACING_ENDPOINT=https://tempo-prod-08-prod-us-central-0.grafana.net
# TRACING_INSECURE=false
# TRACING_HEADERS=authorization=Basic <base64_token>
# TRACING_SAMPLER=traceid_ratio
# TRACING_SAMPLE_RATIO=0.1
#
# ┌──────────────────────────────────────────────┐
# │ 示例 F：Honeycomb.io                         │
# └──────────────────────────────────────────────┘
# TRACING_EXPORTER=otlp-http
# TRACING_ENDPOINT=https://api.honeycomb.io
# TRACING_INSECURE=false
# TRACING_HEADERS=x-honeycomb-team=<YOUR_API_KEY>,x-honeycomb-dataset=aegis
# TRACING_SAMPLER=traceid_ratio
# TRACING_SAMPLE_RATIO=0.2
#
# ┌──────────────────────────────────────────────┐
# │ 示例 G：Datadog Agent (需启用 OTLP receiver)  │
# └──────────────────────────────────────────────┘
# TRACING_EXPORTER=otlp-grpc
# TRACING_ENDPOINT=localhost:4317
# TRACING_INSECURE=true
# TRACING_SERVICE_NAME=aegis-api
# TRACING_ENVIRONMENT=production
#
# ┌──────────────────────────────────────────────┐
# │ 示例 H：阿里云 SLS / AWS X-Ray 等 (via Collector)│
# └──────────────────────────────────────────────┘
# TRACING_EXPORTER=otlp-grpc
# TRACING_ENDPOINT=otel-collector.observability.svc.cluster.local:4317
# TRACING_INSECURE=true
# TRACING_SAMPLER=parentbased_ratio
# TRACING_SAMPLE_RATIO=0.05
#
# ┌──────────────────────────────────────────────┐
# │ 示例 I：生产高 QPS（只采 1%，无父链路全采）   │
# └──────────────────────────────────────────────┘
# TRACING_EXPORTER=otlp-grpc
# TRACING_ENDPOINT=otel-collector:4317
# TRACING_SAMPLER=parentbased_always_on
# TRACING_SAMPLE_RATIO=0.01
# TRACING_BATCH_TIMEOUT=2s
# TRACING_EXPORT_TIMEOUT=5s
#
# ═══════════════════════════════════════════════════════════════════
# 兼容的 OpenTelemetry 官方标准变量（回退）
# ═══════════════════════════════════════════════════════════════════
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer xxx,x-scope-orgid=tenant1
# OTEL_SERVICE_NAME=aegis
# OTEL_SERVICE_VERSION=1.0.0
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.namespace=platform

# ═══════════════════════════════════════════════════════════════════
# IP 封禁响应模式
# ═══════════════════════════════════════════════════════════════════
# 管理员可在封禁 IP 时单独指定模式；此处是缺省值。
#
# 可选值：
#   forbidden        - 返回 HTTP 403 + JSON 错误信封（默认，对合法运维最友好）
#   silent_drop      - 劫持 TCP 连接直接关闭，客户端感知为"连接重置/无响应"（完全不响应）
#   connection_reset - 等同 silent_drop（语义更强）
#   tarpit           - 延迟 N 毫秒后返回 403（消耗攻击者资源）
#   stealth_404      - 伪装 404（让扫描器认为资源不存在）
#   teapot           - 返回 HTTP 418 I'm a teapot
#   rate_choke       - 延迟 2s 后返回 429，Retry-After 5 分钟
FIREWALL_DEFAULT_BAN_MODE=forbidden
# tarpit 模式的延迟毫秒（默认 5000，最大 30000）
FIREWALL_TARPIT_DELAY_MS=5000

# ── Coraza WAF 调优 ────────────────────────────────────────────
# 观察模式：true 时规则全量评估但只记录不拦截（灰度验证误报面）
FIREWALL_CORAZA_DETECTION_ONLY=false
# CRS 入站异常分阈值（越低越严格；官方默认 5 误报极高，本项目默认 40）
FIREWALL_CORAZA_ANOMALY_THRESHOLD=40
# 误报排除规则 ID（CSV）。留空 = 内置默认清单（17 条常见误报）；填 none = 不排除任何规则
# FIREWALL_CORAZA_REMOVED_RULES=920350,920300,941100
FIREWALL_CORAZA_REMOVED_RULES=

# 自动封禁规则覆盖（JSON 数组；留空 = 内置默认规则）。
# 内置默认含 fail2ban 式限流升级：10 分钟内 120 次 rate_limited → 临时封禁 1 小时。
# 字段：name、window/banDuration（Go duration，banDuration "0"=永久）、threshold、
#       severity(low/medium/high/critical)、severityFilter[]、reasonFilter[]（优先生效）
# 示例：
# FIREWALL_AUTO_BAN_RULES=[{"name":"rate_limit_abuse","window":"10m","threshold":120,"banDuration":"1h","severity":"high","reasonFilter":["rate_limited"]}]
FIREWALL_AUTO_BAN_RULES=

# ── 登录防爆破（账号 + IP 双维度，指数退避锁定）────────────────
# 失败计数窗口内：同一账号失败 ≥ 阈值 → 锁账号；同一 IP 失败 ≥ 阈值 → 锁 IP（防撞库）。
# 锁定时长按 2 的幂递增（5m → 10m → 20m ...），封顶 LOGIN_GUARD_MAX_LOCK_DURATION。
# 每次锁定写入一条 risk_assessments（scene=login_bruteforce）。Redis 故障 fail-open。
LOGIN_GUARD_ENABLED=true
LOGIN_GUARD_WINDOW=15m
LOGIN_GUARD_ACCOUNT_THRESHOLD=5
LOGIN_GUARD_IP_THRESHOLD=20
LOGIN_GUARD_BASE_LOCK_DURATION=5m
LOGIN_GUARD_MAX_LOCK_DURATION=24h

# ── 出海代理网关（按目标域名后缀路由出站流量）───────────────────
# 解决「境内部署的服务要访问境外 API」这一类问题：配好线路和后缀规则之后，
# 平台里所有出网调用（OAuth / 支付 / 对象存储 / GeoIP / Webhook / 邮件）
# 都会按同一张路由表决定走直连还是走代理。详见 docs/egress-gateway.md。
EGRESS_ENABLED=false

# 未命中任何规则时的动作：direct（白名单出海，推荐）/ proxy（全局出海）/ reject
EGRESS_DEFAULT_ACTION=direct
# DEFAULT_ACTION=proxy 时的兜底端点（CSV，按 EGRESS_DEFAULT_STRATEGY 选路）
EGRESS_DEFAULT_ENDPOINTS=
# failover（默认）/ round_robin / random / weighted / latency
EGRESS_DEFAULT_STRATEGY=failover

# 端点：name=URL，; 或换行分隔。协议支持
#   http / https（正向代理，CONNECT 隧道）、socks5 / socks5h、ssh、trojan、
#   ss（shadowsocks）、direct（直连，用作 failover 末位兜底）
# 通用查询参数：region / remark / weight / via / probeUrl / dialTimeoutMs /
#              tls / sni / insecure / alpn / forward / disabled
# 示例：
# EGRESS_ENDPOINTS=hk=socks5h://user:pass@10.0.0.1:1080?region=hk&weight=2;us=http://proxy.us:3128;fallback=direct://
EGRESS_ENDPOINTS=

# 规则：<端点列表>=<域名后缀列表>，; 或换行分隔。
# 端点列表用 | 分隔，可加 @策略；也可以写 direct / reject。
# 后缀按标签边界匹配：google.com 命中 www.google.com，不命中 notgoogle.com。
# 需要端口 / CIDR / 调用方（profile）等维度请改用管理端或 EGRESS_CONFIG(_FILE) 的 JSON 写法。
# 示例：
# EGRESS_RULES=hk|us@round_robin=*.google.com,*.googleapis.com,*.gstatic.com;us=*.stripe.com,*.paypal.com;direct=*.aliyuncs.com;reject=*.doubleclick.net
EGRESS_RULES=

# 全量 JSON 配置（字段全集，优先级高于上面的 DSL）。二选一即可。
# EGRESS_CONFIG_FILE=config/egress.json
# EGRESS_CONFIG={"enabled":true,"endpoints":[...],"rules":[...]}

# 连接参数（留空取内置默认）
EGRESS_DIAL_TIMEOUT=10s
EGRESS_TLS_HANDSHAKE_TIMEOUT=10s
EGRESS_RESPONSE_HEADER_TIMEOUT=30s
EGRESS_IDLE_CONN_TIMEOUT=90s
EGRESS_MAX_IDLE_CONNS_PER_HOST=8

# 健康检查：主动探测发现「线路挂了」，被动熔断避免「刚失败的端点马上又被选中」
EGRESS_HEALTH_ENABLED=true
EGRESS_HEALTH_INTERVAL=60s
EGRESS_HEALTH_TIMEOUT=8s
EGRESS_HEALTH_FAILURE_THRESHOLD=2
EGRESS_HEALTH_SUCCESS_THRESHOLD=1
EGRESS_HEALTH_PROBE_URL=https://www.gstatic.com/generate_204
EGRESS_HEALTH_PASSIVE=true
EGRESS_HEALTH_COOLDOWN=30s
# 全部端点都不健康时是否仍然尝试（关掉意味着探测误判会直接切断出海链路）
EGRESS_HEALTH_ALLOW_UNHEALTHY=true
