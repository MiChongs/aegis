# ══════════════════════════════════════════════════════════════════════════
#  Aegis 集群配置清单（docs/distributed-deploy.md）
# ══════════════════════════════════════════════════════════════════════════
#
#  唯一真源是 manager 上的 /etc/aegis/cluster.env（root:root 600）。本文件是它的模板：
#    aegisctl init                 按本模板生成 / 补齐线上文件（已有的键不覆盖）
#    aegisctl config get|set|edit  读写线上文件（输出默认打码）
#    aegisctl config pull          备份到本机 ~/.config/aegisctl/cluster.env（600）
#  改完要 aegisctl deploy 才生效。
#
#  格式与 docker 的 env_file 相同：一行一个 KEY=VALUE，**值不加引号**（引号会原样进值里），
#  不支持行尾注释，# 开头的行是注释。
#
#  aegisctl 认得的标注（写在键的上一行）：
#    #@ secret [长度]   init 时为空就生成随机值（只用字母数字，因为要拼进 DSN 与 URL），默认 32 位
#    #@ hex [字节数]    init 时为空就生成十六进制随机值（如 openssl rand -hex 32）
#    #@ copy 键名       init 时为空就取同文件里另一个键的值
#    #@ required        doctor / deploy 检查不能为空
#
#  aegis-api / aegis-worker / aegis-migrate 与一起听把整个文件当 env_file 读入（不认识的键会被忽略），
#  栈文件里的连接项（POSTGRES_DSN、REDIS_ADDR、NATS_URL 等）再覆盖其中同名项，所以连接串只看本文件的
#  「基础设施凭据」一节，不要在主服务一节里另写 POSTGRES_DSN。
# ══════════════════════════════════════════════════════════════════════════

# ─────────────────────────── 集群与镜像 ───────────────────────────
# 镜像仓库前缀：镜像名是 <前缀>/aegis-server、aegis-console、aegis-listen-together、aegis-risk、
# aegis-risk-cep、aegis-music、aegis-music-deep。私有仓库要先在 manager 上 docker login。
#@ required
AEGIS_REGISTRY=ghcr.io/michongs
# 栈内私有网络 aegis-internal 是否加密（IPsec，跨机房时打开；只在 init 首次建网时起作用，
# 改了要删网重建）。打开后节点间要放行 ESP（IP 协议 50）
AEGIS_INTERNAL_ENCRYPTED=false
# aegisctl build 在 manager 上克隆的仓库（克隆在 /srv/aegis/src）。私有仓库要给 manager 配好拉取凭据
AEGIS_REPO_URL=https://github.com/MiChongs/aegis.git
# 构建参数：HK 构建机到 proxy.golang.org 偶尔被重置，goproxy.cn 稳定
AEGIS_BUILD_GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct
AEGIS_BUILD_MAVEN_MIRROR=
AEGIS_BUILD_MAVEN_OPTS=-Djava.net.preferIPv6Addresses=true
AEGIS_BUILD_PIP_INDEX_URL=https://pypi.org/simple
# 控制台反代的后端地址，构建期烘进产物（必须是内网地址，见 deploy/docker/console.Dockerfile）
AEGIS_CONSOLE_API_BACKEND=http://aegis_aegis-api:8088
# 控制台界面文字，构建期内联进前端产物（改了要重新 aegisctl build console）。留空用默认值
NEXT_PUBLIC_AEGIS_CONSOLE_NAME=
NEXT_PUBLIC_AEGIS_PLATFORM_NAME=
NEXT_PUBLIC_AEGIS_ENVIRONMENT=Production

# ─────────────────────────── 副本与资源 ───────────────────────────
AEGIS_API_REPLICAS=2
AEGIS_WORKER_REPLICAS=2
# 每个节点最多几个副本。单节点时必须大于副本数：start-first 滚动更新要临时多起一个任务
AEGIS_API_MAX_PER_NODE=3
AEGIS_WORKER_MAX_PER_NODE=3
AEGIS_CONSOLE_REPLICAS=2
AEGIS_LISTEN_TOGETHER_REPLICAS=1
# 内存上限（docker 写法：512m、3g）
AEGIS_API_MEMORY=3g
AEGIS_WORKER_MEMORY=2g
AEGIS_CONSOLE_MEMORY=768m
AEGIS_LISTEN_TOGETHER_MEMORY=512m
# Postgres 的上限要容得下 shared_buffers（tuning.sql 是 4GB）与 1 GiB 的 /dev/shm
AEGIS_PG_MEMORY=8g
AEGIS_REDIS_MEMORY=2g
AEGIS_NATS_MEMORY=1536m
AEGIS_TEMPORAL_MEMORY=1g
AEGIS_RUSTFS_MEMORY=1g
# 收到 SIGTERM 后 /readyz 回 503 的时长，让 Traefik 与 VIP 摘掉流量后再关监听
SHUTDOWN_DRAIN_DELAY=5s

# ─────────────────────────── 数据目录与基础设施镜像 ───────────────────────────
# 都在打了对应标签的节点上（绑定目录，不跨节点）。init --import-dokploy 会按现网容器的挂载点改写这几项，
# 让切换时数据原地复用。
AEGIS_PG_DIR=/srv/aegis/postgres
AEGIS_REDIS_DIR=/srv/aegis/redis
AEGIS_NATS_CONF=/srv/aegis/nats/nats-server.conf
AEGIS_NATS_DATA=/srv/aegis/nats/data
AEGIS_RUSTFS_DIR=/srv/aegis/rustfs
AEGIS_RISK_DIR=/srv/aegis/risk
# 镜像版本：init --import-dokploy 会改成现网正在用的版本（升级大版本前先备份）
AEGIS_PG_IMAGE=bryanlin16899/postgres-vector-postgis:17.4
AEGIS_REDIS_IMAGE=redis/redis-stack-server:7.4.0-v6
AEGIS_NATS_IMAGE=nats:2
AEGIS_TEMPORAL_IMAGE=temporalio/auto-setup:1.29.7
AEGIS_TEMPORAL_UI_IMAGE=temporalio/ui:2.42.1
# 主服务与风控两个对象存储共用这个镜像
AEGIS_RUSTFS_IMAGE=rustfs/rustfs:1.0.6

# ─────────────────────────── 基础设施凭据 ───────────────────────────
# Postgres：主库账号（需要 CREATEDB：风控 aegis_risk、音乐 aegis_music、Temporal 的库都由服务自动建）。
# 现网库名是 zeabur_db，导入时会照现网的 POSTGRES_DSN 填。
#@ required
AEGIS_PG_USER=aegis
#@ secret 32
AEGIS_PG_PASSWORD=
#@ required
AEGIS_PG_DB=aegis
# 主服务 POSTGRES_DSN 的查询参数（? 后面的部分）
AEGIS_PG_DSN_PARAMS=sslmode=disable
# Redis（主服务、音乐、一起听共用；风控有自己的 Redis Cluster）
#@ secret 32
AEGIS_REDIS_PASSWORD=
# 追加给 redis-server 的参数，例如 --appendonly yes --maxmemory 1536mb
AEGIS_REDIS_EXTRA_ARGS=
# NATS：账户 APP 的用户（主服务、风控、音乐、一起听共用）。init 生成 nats-server.conf 时写入
#@ required
AEGIS_NATS_USER=aegis
#@ secret 32
AEGIS_NATS_PASSWORD=
# Temporal 用主库所在的 Postgres（auto-setup 自动建 temporal、temporal_visibility 两个库）
#@ copy AEGIS_PG_USER
TEMPORAL_DB_USER=
#@ copy AEGIS_PG_PASSWORD
TEMPORAL_DB_PASSWORD=
TEMPORAL_DB_NAME=temporal
TEMPORAL_VISIBILITY_DB_NAME=temporal_visibility
# 主服务对象存储 RustFS（多节点时上传文件放这里）。控制台存储中心加 RustFS 存储池：
#   endpoint aegis-rustfs:9000、不用 SSL，access key / secret key 用下面两项（或在 RustFS 控制台另建用户）
#@ secret 20
AEGIS_RUSTFS_ACCESS_KEY=
#@ secret 40
AEGIS_RUSTFS_SECRET_KEY=

# ─────────────────────────── 入口路由（Traefik 文件配置）───────────────────────────
# aegisctl deploy 渲染 deploy/swarm/traefik/aegis.yml.tmpl，写到 /etc/dokploy/traefik/dynamic/aegis.yml。
# 只写 routers / services，不动 entryPoints（现网的 forwardedHeaders.trustedIPs 在 traefik.yml 里）。
# 域名逗号分隔；留空的那一组不生成路由。
#@ required
AEGIS_API_DOMAINS=aegis.karpov.cn,system.karpov.cn,aegis-origin.karpov.cn
#@ required
AEGIS_CONSOLE_DOMAINS=console.karpov.cn
AEGIS_LISTEN_TOGETHER_DOMAINS=
AEGIS_TEMPORAL_UI_DOMAINS=
# Temporal UI 的中间件（Traefik 名字，逗号分隔，如 aegis-temporal-auth@file）；对外时务必加认证
AEGIS_TEMPORAL_UI_MIDDLEWARES=
AEGIS_RUSTFS_DOMAINS=
AEGIS_TRAEFIK_ENTRYPOINT_HTTP=web
AEGIS_TRAEFIK_ENTRYPOINT_HTTPS=websecure
# 留空则用 Traefik 的默认证书（例如 CDN 回源只验证 SNI 不验证证书时）
AEGIS_TRAEFIK_CERT_RESOLVER=letsencrypt
# 明文入口怎么处理：redirect（跳 HTTPS，与 Dokploy 开了 HTTPS 的域名相同）| serve（明文也转发）| off（不监听）
AEGIS_TRAEFIK_HTTP_MODE=redirect
# 跳转用的中间件（Dokploy 自带 middlewares.yml 里的 redirect-to-https）
AEGIS_TRAEFIK_REDIRECT_MIDDLEWARE=redirect-to-https@file
# 路由优先级：高于 Dokploy 给旧应用生成的同域名路由，切换后新栈优先
AEGIS_TRAEFIK_PRIORITY=1000
# 动态配置文件位置
AEGIS_TRAEFIK_DYNAMIC_FILE=/etc/dokploy/traefik/dynamic/aegis.yml

# ─────────────────────────── 风控平台（docs/risk-deploy-hk.md）───────────────────────────
# 主服务与风控服务之间的内部令牌（主服务也读这一项）
#@ hex 32
RISK_INTERNAL_TOKEN=
#@ secret 32
RISK_REDIS_PASSWORD=
#@ secret 32
RISK_CLICKHOUSE_PASSWORD=
# Nebula 上限 24 个字符
#@ secret 24
RISK_NEBULA_PASSWORD=
# 风控对象存储 RustFS（Milvus 与模型文件）。init --import-dokploy 会沿用现网 risk-minio 的那一对，
# 这样 objstore migrate 搬过去的数据与 Milvus 的配置对得上
#@ secret 20
RISK_RUSTFS_ACCESS_KEY=
#@ secret 40
RISK_RUSTFS_SECRET_KEY=
# 代理 / CDN / 服务器出口地址：不当作用户 IP 写进关系图（与 TRUSTED_PROXIES 保持一致，另加代用户发请求的出口）
RISK_PROXY_CIDRS=
# RISK 流的容量（NATS 的 jetstream.max_file 是 8G）
RISK_STREAM_MAX_BYTES=3G
RISK_TIMEOUT=300ms

# ─────────────────────────── 音乐个性化 ───────────────────────────
# 主服务与音乐服务一致（主服务也读这一项）
#@ hex 32
MUSIC_INTERNAL_TOKEN=
MUSIC_EVENTS_ENABLED=true

# ─────────────────────────── 一起听 ───────────────────────────
# 主服务调一起听内部接口的令牌（一起听的 LT_INTERNAL_TOKEN 由栈文件从这里取）
#@ hex 32
LISTEN_TOGETHER_INTERNAL_TOKEN=
LISTEN_TOGETHER_ALLOWED_ORIGINS=*
# 客户端可连的 wss 地址（逗号分隔，经 CDN / 反代的域名）；留空表示未开通
LISTEN_TOGETHER_ENDPOINTS=
# 票据签名种子（base64 的 32 字节，逗号分隔）；留空从 JWT_SECRET 派生
LISTEN_TOGETHER_TICKET_KEYS=
LISTEN_TOGETHER_TICKET_TTL=10m
# 其他调参项按需取消注释（服务默认值见 services/listentogether）
# LT_ROOM_CAPACITY=
# LT_ROOM_IDLE_TTL=
# LT_MEMBER_GRACE=

# ─────────────────────────── 备份 ───────────────────────────
AEGIS_BACKUP_DIR=/srv/aegis/backups
AEGIS_BACKUP_KEEP=7

# ══════════════════════════════════════════════════════════════════════════
#  aegis-api / aegis-worker 环境变量（.env.example 的生产取值，完整说明见仓库根目录 .env.example）
#  栈文件会覆盖：POSTGRES_DSN、REDIS_ADDR、REDIS_PASSWORD、NATS_URL、TEMPORAL_HOST_PORT、
#  RISK_ETCD_ENDPOINTS、MUSIC_RPC_URL、LISTEN_TOGETHER_RPC_URL、MIGRATE_ON_BOOT、AEGIS_ROLE、AEGIS_NODE_ID、
#  HTTP_PORT、WORKER_HEALTH_ADDR。init --import-dokploy 会把现网 aegis-api 的其余变量补在文件末尾。
# ══════════════════════════════════════════════════════════════════════════

APP_NAME=aegis
APP_ENV=production
DOCS_PORTAL_URL=/developers
#@ required
API_BASE_URL=https://aegis.karpov.cn
#@ required
CONSOLE_BASE_URL=https://console.karpov.cn
APP_DEFAULT_IANA_TIMEZONE=Asia/Shanghai
LEGAL_CONTACT_EMAIL=

# ── 客户端 IP（docs/client-ip.md）──
# 必须包含 CDN 回源节点：现网值经 --import-dokploy 原样导入。新增 CDN 节点时 Traefik 的 trustedIPs 也要同时加
TRUSTED_PROXIES=infra
CLIENT_IP_STRATEGY=auto
CLIENT_IP_HEADER=
CLIENT_IP_DEBUG_HEADER=false

# ── 跨域 ──
CORS_ENABLED=true
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOW_ORIGINS=https://console.karpov.cn
CORS_ALLOW_CREDENTIALS=false

# ── 管理员与令牌 ──
#@ secret 48
ADMIN_API_TOKEN=
ADMIN_BOOTSTRAP_ACCOUNT=superadmin
# 只在库里还没有管理员时用来建首个账号
#@ secret 24
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_DISPLAY_NAME=Super Administrator
ADMIN_BOOTSTRAP_EMAIL=
# JWT_SECRET 签管理员令牌并派生其他密钥；换掉它所有会话失效
#@ secret 64
JWT_SECRET=
JWT_ISSUER=aegis
JWT_TTL=720h
JWT_REFRESH_TTL=168h
# 用户登录令牌（PASETO v4.local）的密钥；为空时由 JWT_SECRET 派生。现网若为空，导入后保持为空
SESSION_TOKEN_KEY=
SESSION_TOKEN_PREVIOUS_KEYS=
SESSION_TOKEN_ACCEPT_JWT=true
# 加密 OAuth client_secret、通知渠道密钥等；必须长期稳定，现网值经导入原样保留
#@ secret 48
SECURITY_MASTER_KEY=
SECURITY_PASSKEY_RP_ID=
SECURITY_PASSKEY_RP_ORIGINS=https://console.karpov.cn
SECURITY_PASSKEY_RP_DISPLAY_NAME=

# ── HTTP 服务 ──
READ_TIMEOUT=5s
WRITE_TIMEOUT=0
SHUTDOWN_TIMEOUT=10s
AI_RELAY_MAX_BODY_BYTES=33554432
AI_RELAY_READ_TIMEOUT=5m
AI_UPSTREAM_IDLE_TIMEOUT=5m

# ── Postgres 连接池 ──
# 每个实例的上限。tuning.sql 的 max_connections=200：(api + worker + 滚动时多出的 1 个) × 本值要留余量
POSTGRES_MAX_CONNS=30
POSTGRES_MIN_CONNS=4
POSTGRES_SESSION_TIMEZONE=Asia/Shanghai
POSTGRES_APPLICATION_NAME=aegis
POSTGRES_STATEMENT_TIMEOUT=30s
POSTGRES_IDLE_IN_TX_TIMEOUT=60s
POSTGRES_LOCK_TIMEOUT=10s
DB_MONITOR_ENABLED=true
DB_DRAIN_TIMEOUT=15s

# ── Redis / NATS / Temporal（地址由栈文件给，这里只放其余项）──
REDIS_DB=0
REDIS_KEY_PREFIX=aegis
NATS_STREAM_NAME=AEGIS_EVENTS
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=aegis-workflow

# ── 本地数据（每个副本自己的命名卷 /app/data，不跨节点共享）──
# 上传文件不要用本地存储：控制台存储中心配 RustFS 存储池（aegis-rustfs）后用存储迁移搬过去
ADMIN_USER_SEARCH_ROOT_DIR=data/search
PAYMENT_RECEIPT_ROOT_DIR=data/payment-bills
EGRESS_MIHOMO_HOME=data/mihomo

# ── 对外 OAuth2 授权服务器（未在统一栈里编排 Hydra；开启前先单独部署）──
OAUTH2_SERVER_ENABLED=false

# ── 链路追踪 ──
TRACING_ENABLED=false
TRACING_EXPORTER=
TRACING_ENDPOINT=
TRACING_SERVICE_NAME=aegis
TRACING_ENVIRONMENT=production
